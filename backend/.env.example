# PostgreSQL: se impostato, Django usa Postgres; altrimenti SQLite in backend/data/db.sqlite3
# Docker Compose imposta DATABASE_URL nel servizio backend.
DATABASE_URL=postgresql://latex:latex@localhost:5432/latex

# Obbligatorio in produzione (Docker / deploy)
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (origine del frontend)
# FRONTEND_URL=http://localhost:5173
