# Impostazioni consigliate per produzione (Hostinger VPS)
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=imposta-una-chiave-lunga-e-casuale
DJANGO_ALLOWED_HOSTS=api.tuodominio.it

# Origine frontend usata per CORS
FRONTEND_URL=https://www.tuodominio.it
# Facoltativo: lista esplicita separata da virgole
# CORS_ALLOWED_ORIGINS=https://www.tuodominio.it,https://app.tuodominio.it

# PostgreSQL (opzione A): URL completo
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# PostgreSQL (opzione B): variabili separate
POSTGRES_DB=cardy
POSTGRES_USER=cardy
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
POSTGRES_CONN_MAX_AGE=60

# Hardening HTTP
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
