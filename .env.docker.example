# Copia in .env.docker (gitignored) per docker compose.

POSTGRES_DB=cardy
POSTGRES_USER=cardy
POSTGRES_PASSWORD=cardy

DATABASE_URL=postgresql://cardy:cardy@db:5432/cardy?sslmode=disable

DJANGO_SECRET_KEY=change-me
