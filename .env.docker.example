# Copia in .env.docker e adatta (stesso file per Postgres e Django).

POSTGRES_DB=cardy
POSTGRES_USER=cardy
POSTGRES_PASSWORD=cardy

# Deve coincidere con user/password/db sopra e host `db` (nome servizio compose).
DATABASE_URL=postgresql://cardy:cardy@db:5432/cardy?sslmode=disable

DJANGO_SECRET_KEY=imposta-una-chiave-lunga-e-casuale
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173

# Per test locale senza HTTPS davanti al container
DJANGO_SECURE_SSL_REDIRECT=false

# Opzionale: CORS esplicito
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
