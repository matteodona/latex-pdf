# =============================================================================
# Dokploy — App BACKEND (API)
# Copia nel tab Environment dell'app Docker che usa il Dockerfile in radice.
# =============================================================================

DJANGO_SETTINGS_MODULE=config.settings.production

DJANGO_SECRET_KEY=<genera-con-python-c-import-secrets-print-secrets-token-hex-32>

# Includi api. e 127.0.0.1/localhost per health check Docker e Traefik
DJANGO_ALLOWED_HOSTS=api.tuodominio.it,127.0.0.1,localhost

FRONTEND_URL=https://www.tuodominio.it

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/NOMEDB?sslmode=require

DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true

# Opzionale: GUNICORN_WORKERS=2  GUNICORN_TIMEOUT=120

# =============================================================================
# Dokploy — App FRONTEND (Nixpacks)
# Env/build vars consigliate:
#   VITE_BACKEND_URL=https://api.tuodominio.it
#   NIXPACKS_INSTALL_CMD=npm ci
#   NIXPACKS_BUILD_CMD=npm run build
#   NIXPACKS_START_CMD=npx serve -s dist -l 3000
#   PORT=3000
# Domain: container port 3000
# =============================================================================
